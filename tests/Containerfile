FROM docker.io/library/python:3.14

RUN apt-get update && apt-get install -y --no-install-recommends libegl1 libgl1 libgl1-mesa-dri mesa-vulkan-drivers libvulkan1 glslang-tools && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir setuptools pytest gcovr

WORKDIR /app
COPY . .
RUN MODERNGL_COVERAGE=1 python setup.py build_ext --inplace

CMD python -m pytest -v tests --ignore=tests/test_vulkan.py; status=$?; python -m pytest -v tests/test_vulkan.py || status=1; gcovr -r . --filter src/moderngl.c --filter src/vulkan.h; exit $status

# podman build . -f tests/Containerfile -t moderngl-tests && podman run --rm moderngl-tests
